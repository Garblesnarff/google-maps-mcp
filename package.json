{
  "name": "google-maps-mcp-server-enhanced",
  "version": "4.1.0",
  "description": "Google Maps MCP server with 19 tools: geocoding, Places API (New), Routes API v2, elevation, weather, air quality, solar, pollen, street view, static maps, and garden/climate planning (frost dates, growing degree days, soil conditions, day length, hardiness zone). Built for camping trip planning, outdoor research, gardening, and location analysis.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-maps-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "tsc && node --test dist/tests/*.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-maps",
    "street-view",
    "static-maps",
    "weather",
    "air-quality",
    "solar",
    "pollen",
    "camping",
    "outdoor-research",
    "environmental-data",
    "trip-planning",
    "garden",
    "gardening",
    "climate"
  ],
  "author": "Rob",
  "license": "MIT"
}
